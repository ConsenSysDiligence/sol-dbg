{
    "name": "sol-dbg",
    "version": "0.10.3",
    "description": "Small (experimental) Solidity-level debugger built around EthereumJS",
    "keywords": [],
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "commonjs",
    "scripts": {
        "clean": "rm -rf dist/",
        "transpile": "tsc",
        "build": "npm run clean && npm run transpile",
        "lint": "eslint src/ test/ --ext=ts",
        "lint:fix": "eslint src/ test/ --ext=ts --fix",
        "test": "NODE_OPTIONS='--max-old-space-size=2048' jest --coverage",
        "prepare": "npm run build",
        "docs:render": "typedoc",
        "docs:clear": "rm -rf docs/",
        "docs:refresh": "npm run docs:clear && npm run docs:render"
    },
    "dependencies": {
        "@ethereumjs/block": "10.1.2",
        "@ethereumjs/blockchain": "10.1.2",
        "@ethereumjs/common": "10.1.2",
        "@ethereumjs/evm": "10.1.2",
        "@ethereumjs/rlp": "10.1.2",
        "@ethereumjs/statemanager": "10.1.2",
        "@ethereumjs/tx": "10.1.2",
        "@ethereumjs/util": "10.1.2",
        "@ethereumjs/vm": "10.1.2",
        "cbor": "^10.0.3",
        "ethereum-cryptography": "2.2.1",
        "solc-typed-ast": "20.0.2",
        "src-location": "1.1.0",
        "web3-eth-abi": "4.4.1"
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "7.29.7",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@types/debug": "4.1.13",
        "@types/fs-extra": "11.0.4",
        "@types/jest": "30.0.0",
        "@types/lru-cache": "7.10.10",
        "@types/node": "25.9.1",
        "@typescript-eslint/eslint-plugin": "8.60.0",
        "@typescript-eslint/parser": "8.60.0",
        "eslint": "10.4.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.6",
        "expect": "30.4.1",
        "fs-extra": "11.3.5",
        "globals": "^17.6.0",
        "jest": "30.4.2",
        "prettier": "3.8.3",
        "ts-jest": "29.4.11",
        "ts-node": "10.9.2",
        "typedoc": "0.28.19",
        "typescript": "6.0.3"
    },
    "homepage": "https://github.com/ConsenSysDiligence/sol-dbg",
    "bugs": "https://github.com/ConsenSysDiligence/sol-dbg/issues",
    "repository": "https://github.com/ConsenSysDiligence/sol-dbg",
    "license": "Apache-2.0"
}
